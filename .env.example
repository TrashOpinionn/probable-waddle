# ============================================================
# 1chan 环境变量模板
# 复制为 .env 后按需修改；部署到 Render 时在 Environment 中逐项填写。
# ============================================================

# ---------- 基础 ----------
PORT=3000
ADMIN_PATH=/sch-admin-2026
ADMIN_PASSWORD=change-me-to-a-strong-password

# ---------- 内容与清理 ----------
POST_RETENTION_DAYS=30
CLEANUP_SCHEDULE=0 3 1 * *
MAX_UPLOAD_MB=5
COVER_MAX_MB=2
POST_COOLDOWN_SECONDS=10
ANON_SALT=please-change-this-to-a-random-string

# ---------- 数据库 ----------
# 不设置 DATABASE_URL 时使用本地 SQLite（适合本地开发）。
# 部署到 Render 免费版时，建议填写 Supabase 或 Render PostgreSQL 的连接串。
# Supabase：Project Settings -> Database -> Connection string -> Session pooler
# 示例：
# DATABASE_URL=postgresql://postgres.xxxx:密码@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
#
# 也可以用 SUPABASE_DB_URL 作为同义变量：
# SUPABASE_DB_URL=postgresql://...
#
# 远程数据库一般需要 SSL；本地 PostgreSQL 可改为 false。
PGSSL=true

# ---------- 图片存储 ----------
# local（默认，保存到本地 uploads/，Render 免费版会丢）
# cloudinary 或 supabase（推荐，免费额度够用，重启/重新部署不丢）
STORAGE_DRIVER=local

# Cloudinary（STORAGE_DRIVER=cloudinary 时必填）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase Storage（STORAGE_DRIVER=supabase 时必填）
# 需要先在 Supabase 创建一个 Public bucket，例如 1chan
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=1chan
